[core]
	repositoryformatversion = 0
	filemode = true
	bare = false
	logallrefupdates = true
[remote "origin"]
	url = https://github.com/team-proflujo/Neet-Predictor.git
	fetch = +refs/heads/*:refs/remotes/origin/*
[branch "main"]
	remote = origin
	merge = refs/heads/main
[branch "latest-ui-neet-predictor"]
	vscode-merge-base = origin/main
	remote = origin
	merge = refs/heads/latest-ui-neet-predictor
[branch "ai-neet-predictor"]
	vscode-merge-base = origin/latest-ui-neet-predictor
	remote = origin
	merge = refs/heads/ai-neet-predictor
[branch "karnataka-ai-neet-predict"]
	vscode-merge-base = origin/ai-neet-predictor
	remote = origin
	merge = refs/heads/karnataka-ai-neet-predict
